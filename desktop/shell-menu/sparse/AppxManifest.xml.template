<?xml version="1.0" encoding="utf-8"?>
<!-- Identity package (sparse package) for the GitHub installer. It holds no files of the app:
     AllowExternalContent points it at the installation folder, so Windows 11 can show the
     Poufnik context menu at the top level, as for the Microsoft Store package. The installer
     registers it in hooks.nsh (Add-AppxPackage -ExternalLocation). Built and signed by
     build_sparse_package.py; Publisher must equal the subject of the signing certificate. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 com desktop4 desktop5 rescap">

  <Identity
    Name="Poufnik.MenuKontekstowe"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Poufnik</DisplayName>
    <PublisherDisplayName>Kancelaria Radcy Prawnego Michał Paszkiewicz</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pl-pl" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Poufnik"
      Executable="Poufnik.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <!-- AppListEntry="none": the installer already made the Start menu shortcut. -->
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Poufnik"
        Description="Poufnik - menu kontekstowe"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <!-- Same file types as AppxManifest.xml.template (Store package); which item shows for
           which file is decided in poufnik_shell_menu.dll. The CLSID must match
           CLSID_POUFNIK_MENU_DIRECT in shell-menu/src/com.rs. -->
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
{{ITEM_TYPES}}
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Poufnik - menu kontekstowe">
              <com:Class Id="d2c5f856-c78a-4afa-bc32-6259d0e125c7" Path="poufnik_shell_menu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
