{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poufnik",
  "mainBinaryName": "Poufnik",
  "version": "0.1.0",
  "identifier": "KancelariaRadcyPrawnegoMi.Poufnik",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Poufnik",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://account.lawtern.com https://github.com/paszkiewiczmichal/poufnik/releases/latest/download/latest.json"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/anonymizer-engine"],
    "resources": {
      "binaries/_internal": "_internal",
      "binaries/tesseract": "binaries/tesseract"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNUYyRUUxODlFRTNDRDQKUldUVVBPNko0UzVmRWNhMkVQb2ZJK1hrdnA1Nm90NkhaV1JVTjJ5eVdUeUdoclJORjNHZWUremYK",
      "endpoints": [
        "https://github.com/paszkiewiczmichal/poufnik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
